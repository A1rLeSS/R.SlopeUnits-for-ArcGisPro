<?xml version="1.0" encoding="utf-8" ?>
<ArcGIS defaultAssembly="BasinSlopeTools.dll"
        defaultNamespace="BasinSlopeTools"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry http://schemas.esri.com/DADF/Registry/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{7D2C4A9E-3F1B-4A77-9B6E-6B1C2D9A4E11}" version="0.6" desktopVersion="3.0" product="ArcGISPro">
    <Name>R.slopeunits 斜坡单元</Name>
    <Description>在 ArcGIS Pro 内调用 GRASS R.slopeunits 生成斜坡单元</Description>
    <Image>Images\AddInDesktop32.png</Image>
    <Author>BasinSlopeCoupling</Author>
    <Company>BasinSlopeCoupling</Company>
    <Date>2026-11-14</Date>
    <Subject>Geoprocessing</Subject>
  </AddInInfo>
  <modules>
    <insertModule id="BasinSlopeTools_Module" className="Module1" autoLoad="false" caption="R.slopeunits 斜坡单元">
      <tabs>
        <tab id="BasinSlopeTools_Tab" caption="R.slopeunits 斜坡单元">
          <group refID="BasinSlopeTools_Group" />
        </tab>
      </tabs>
      <groups>
        <group id="BasinSlopeTools_Group" caption="R.slopeunits" appearsOnAddInTab="false">
          <button refID="BasinSlopeTools_SlopeUnitsButton" />
          <button refID="BasinSlopeTools_BatchButton" />
          <button refID="BasinSlopeTools_SweepButton" />
          <button refID="BasinSlopeTools_QualityButton" />
          <button refID="BasinSlopeTools_UpdateButton" />
          <button refID="BasinSlopeTools_AboutButton" />
        </group>
      </groups>
      <controls>
        <button id="BasinSlopeTools_SlopeUnitsButton" caption="生成斜坡单元" className="SlopeUnitsButton" loadOnClick="true"
                smallImage="Images/Generate16.png" largeImage="Images/Generate32.png" />
        <button id="BasinSlopeTools_BatchButton" caption="批量生成" className="BatchButton" loadOnClick="true"
                smallImage="Images/Batch16.png" largeImage="Images/Batch32.png" />
        <button id="BasinSlopeTools_SweepButton" caption="参数扫描" className="SweepButton" loadOnClick="true"
                smallImage="Images/Sweep16.png" largeImage="Images/Sweep32.png" />
        <button id="BasinSlopeTools_QualityButton" caption="质量报告" className="QualityReportButton" loadOnClick="true"
                smallImage="Images/Quality16.png" largeImage="Images/Quality32.png" />
        <button id="BasinSlopeTools_UpdateButton" caption="检查更新" className="UpdateButton" loadOnClick="true"
                smallImage="Images/About16.png" largeImage="Images/About32.png" />
        <button id="BasinSlopeTools_AboutButton" caption="关于/版权" className="AboutButton" loadOnClick="true"
                smallImage="Images/About16.png" largeImage="Images/About32.png" />
      </controls>
    </insertModule>
  </modules>
</ArcGIS>








